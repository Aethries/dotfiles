;; Kanata configuration with Navigation & Visual Modes
(defcfg
  process-unmapped-keys yes
)

(defsrc)

(defalias
  ;; Chuyển đổi giữa các Layer
  to-nav   (layer-switch nav)
  cap-nav  (fork caps @to-nav (lsft rsft))
  to-base  (layer-switch base)
  to-vis   (layer-switch visual)

  ;; --- Navigation Mode Aliases ---
  ;; Điều hướng Tab khi giữ Shift + h / l trong nav layer
  ;; Shift đang được giữ liên tục:
  ;; h: gửi C-tab (kết hợp với Shift đang giữ thành Ctrl+Shift+Tab) mà không làm ngắt Shift
  ;; l: tạm thời nhả Shift trong lúc gửi C-tab rồi phục hồi lại Shift
  h-nav    (fork left C-tab (lsft rsft))
  l-nav    (fork rght (unshift lctl tab) (lsft rsft))

  ;; Phím $ (Shift + 4) hoặc 4 về End
  end-nav  (fork end (unshift end) (lsft rsft))

  ;; x: Del (xóa tới) / Shift + x: Backspace (xóa lùi)
  x-nav    (fork del (unshift bspc) (lsft rsft))

  ;; g: Đầu file (Ctrl+Home) / Shift + g: Cuối file (Ctrl+End)
  g-nav    (fork C-home (unshift lctl end) (lsft rsft))

  ;; z: Undo (Ctrl+z) / Shift + z: Redo (Ctrl+y)
  z-nav    (fork C-z (unshift lctl y) (lsft rsft))

  ;; Kích hoạt chuột Warpd (Super + ;) và trả Kanata về base layer để Warpd nhận phím gốc
  warp-m   (multi (release-key lsft) (release-key rsft) (macro M-scln) (layer-switch base))

  ;; --- Visual Mode Aliases ---
  ;; Thao tác vùng chọn: Copy / Cut / Paste / Delete rồi quay lại nav mode
  vis-y    (multi (release-key lsft) (release-key rsft) C-c (layer-switch nav))
  vis-c    (multi (release-key lsft) (release-key rsft) C-x (layer-switch nav))
  vis-p    (multi (release-key lsft) (release-key rsft) C-v (layer-switch nav))
  vis-del  (multi (release-key lsft) (release-key rsft) bspc (layer-switch nav))

  ;; Bôi đen đầu / cuối tài liệu trong Visual mode
  g-vis    (fork C-S-home (multi (release-key lsft) (release-key rsft) C-S-end) (lsft rsft))

  ;; Bôi đen cuối dòng trong Visual mode
  end-vis  (fork S-end (multi (release-key lsft) (release-key rsft) S-end) (lsft rsft))
)

;; -------------------------------------------------------------
;; 1. Base Layer (Normal Typing)
;; -------------------------------------------------------------
(deflayermap (base)
  caps @cap-nav
)

;; -------------------------------------------------------------
;; 2. Navigation Layer (Vim-like Modal Navigation)
;; -------------------------------------------------------------
(deflayermap (nav)
  ;; Thoát về normal mode
  caps @to-base
  ret  @to-base
  esc  @to-base
  i    @to-base

  ;; Mũi tên điều hướng cơ bản
  h    @h-nav
  j    down
  k    up
  l    @l-nav

  ;; Cuộn trang (Scroll down / up)
  d    pgdn
  u    pgup

  ;; Đầu dòng / Cuối dòng
  0    home
  4    @end-nav

  ;; Nhảy theo từng từ (Word jump)
  b    C-left
  w    C-rght
  e    C-rght

  ;; Đầu văn bản / Cuối văn bản (Document bounds)
  g    @g-nav

  ;; Xóa ký tự: x (Del) / X (Backspace)
  x    @x-nav

  ;; Undo / Redo
  z    @z-nav

  ;; Clipboard
  y    C-c
  p    C-v
  c    C-x

  ;; Đóng tab & Tìm kiếm
  q    C-w
  /    C-f

  ;; Bật chế độ chuột Warpd
  m    @warp-m
  scln @warp-m

  ;; Chuyển sang Visual Selection Mode
  v    @to-vis
)

;; -------------------------------------------------------------
;; 3. Visual Layer (Text Selection Mode)
;; -------------------------------------------------------------
(deflayermap (visual)
  ;; Thoát / Hủy visual mode
  caps @to-base
  ret  @to-base
  i    @to-base
  esc  @to-nav
  v    @to-nav

  ;; Bôi đen theo hướng mũi tên
  h    S-left
  j    S-down
  k    S-up
  l    S-rght

  ;; Bôi đen theo trang
  d    S-pgdn
  u    S-pgup

  ;; Bôi đen về đầu / cuối dòng
  0    S-home
  4    @end-vis

  ;; Bôi đen theo từng từ
  b    C-S-left
  w    C-S-rght
  e    C-S-rght

  ;; Bôi đen về đầu / cuối tài liệu
  g    @g-vis

  ;; Thao tác vùng chọn
  y    @vis-y
  c    @vis-c
  x    @vis-c
  p    @vis-p
  del  @vis-del
  bspc @vis-del
)
