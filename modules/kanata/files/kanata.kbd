;; Kanata configuration with Navigation, Visual & Mouse Modes
(defcfg
  process-unmapped-keys yes
)

(defsrc)

(defalias
  ;; Chuyển đổi giữa các Layer
  to-nav    (layer-switch nav)
  nav-hold  (layer-while-held nav)
  to-base   (layer-switch base)
  cap-th    (tap-hold-press 200 200 esc @nav-hold)
  cap-base  (fork @cap-th @to-nav (lsft rsft))
  cap-nav   (fork @to-base @to-base (lsft rsft))
  to-vis    (layer-switch visual)

  ;; Kích hoạt chuột Warpd (Super + ;) và chuyển Kanata sang mouse layer
  warp-m    (multi (release-key lsft) (release-key rsft) (macro M-scln) (layer-switch mouse))
  scln-base (fork scln (multi (macro M-scln) (layer-switch mouse)) (lmet rmet))

  ;; Phím Enter / Tab trong Nav mode: Nhận phím thật vào IDE rồi mới về Normal mode
  ret-base  (multi ret (layer-switch base))
  tab-base  (multi tab (layer-switch base))

  ;; --- Navigation Mode Aliases ---
  ;; Điều hướng Tab khi giữ Shift + h / l trong nav layer
  h-nav     (fork left C-tab (lsft rsft))
  l-nav     (fork rght (unshift lctl tab) (lsft rsft))

  ;; Phím $ (Shift + 4) hoặc 4 về End
  end-nav   (fork end (unshift end) (lsft rsft))

  ;; x: Del (xóa tới) / Shift + x: Backspace (xóa lùi)
  x-nav     (fork del (unshift bspc) (lsft rsft))

  ;; g: Đầu file (Ctrl+Home) / Shift + g: Cuối file (Ctrl+End)
  g-nav     (fork C-home (unshift lctl end) (lsft rsft))

  ;; z: Undo (Ctrl+z) / Shift + z: Redo (Ctrl+y)
  z-nav     (fork C-z (unshift lctl y) (lsft rsft))

  ;; --- Visual Mode Aliases ---
  ;; Thao tác vùng chọn: Copy / Cut / Paste / Delete rồi quay lại nav mode
  vis-y     (multi (release-key lsft) (release-key rsft) C-c (layer-switch nav))
  vis-c     (multi (release-key lsft) (release-key rsft) C-x (layer-switch nav))
  vis-p     (multi (release-key lsft) (release-key rsft) C-v (layer-switch nav))
  vis-del   (multi (release-key lsft) (release-key rsft) bspc (layer-switch nav))

  ;; Bôi đen đầu / cuối tài liệu trong Visual mode
  g-vis     (fork C-S-home (multi (release-key lsft) (release-key rsft) C-S-end) (lsft rsft))

  ;; Bôi đen cuối dòng trong Visual mode
  end-vis   (fork S-end (multi (release-key lsft) (release-key rsft) S-end) (lsft rsft))

  ;; --- Mouse Mode Aliases ---
  ;; Phím n: Gửi Esc tắt Warpd và chuyển Kanata sang nav layer
  m-to-nav  (multi (macro esc) (layer-switch nav))
  m-exit    (multi (macro esc) (layer-switch base))
  m-i       (multi (macro i)   (layer-switch base))
  m-c       (multi (macro c)   (layer-switch base))
  m-slash   (multi (macro /)   (layer-switch base))
)

;; -------------------------------------------------------------
;; 1. Base Layer (Normal Typing)
;; -------------------------------------------------------------
(deflayermap (base)
  caps @cap-base
  scln @scln-base
)

;; -------------------------------------------------------------
;; 2. Navigation Layer (Vim-like Modal Navigation)
;; -------------------------------------------------------------
(deflayermap (nav)
  ;; Thoát về normal mode (Caps hoặc Shift+Caps đều về base)
  caps @cap-nav
  esc  @to-base
  i    @to-base

  ;; Enter và Tab: gửi phím thực vào IDE rồi quay về normal mode
  ret  @ret-base
  tab  @tab-base

  ;; Mũi tên điều hướng cơ bản
  h    @h-nav
  j    down
  k    up
  l    @l-nav

  ;; Cuộn trang (Scroll down / up)
  d    pgdn
  u    pgup

  ;; Đầu dòng / Cuối dòng
  0    home
  4    @end-nav

  ;; Nhảy theo từng từ (Word jump)
  b    C-left
  w    C-rght
  e    C-rght

  ;; Đầu văn bản / Cuối văn bản (Document bounds)
  g    @g-nav

  ;; Xóa ký tự: x (Del) / X (Backspace)
  x    @x-nav

  ;; Undo / Redo
  z    @z-nav

  ;; Clipboard
  y    C-c
  p    C-v
  c    C-x

  ;; Đóng tab & Tìm kiếm
  q    C-w
  /    C-f

  ;; Bật chế độ chuột Warpd
  m    @warp-m
  scln @warp-m

  ;; Chuyển sang Visual Selection Mode
  v    @to-vis
)

;; -------------------------------------------------------------
;; 3. Visual Layer (Text Selection Mode)
;; -------------------------------------------------------------
(deflayermap (visual)
  ;; Thoát / Hủy visual mode
  caps @to-base
  ret  @to-base
  i    @to-base
  esc  @to-nav
  v    @to-nav

  ;; Bôi đen theo hướng mũi tên
  h    S-left
  j    S-down
  k    S-up
  l    S-rght

  ;; Bôi đen theo trang
  d    S-pgdn
  u    S-pgup

  ;; Bôi đen về đầu / cuối dòng
  0    S-home
  4    @end-vis

  ;; Bôi đen theo từng từ
  b    C-S-left
  w    C-S-rght
  e    C-S-rght

  ;; Bôi đen về đầu / cuối tài liệu
  g    @g-vis

  ;; Thao tác vùng chọn
  y    @vis-y
  c    @vis-c
  x    @vis-c
  p    @vis-p
  del  @vis-del
  bspc @vis-del
)

;; -------------------------------------------------------------
;; 4. Mouse Layer (Active when Warpd is running)
;; -------------------------------------------------------------
(deflayermap (mouse)
  ;; Phím n: Tắt Warpd và chuyển sang nav mode
  n    @to-nav

  ;; Phím thoát Warpd về base typing mode
  esc  @m-exit
  caps @m-exit
  ret  @m-exit
  i    @m-i
  c    @m-c
  /    @m-slash
)
