#!/usr/bin/env bash

set -euo pipefail

# Determine DOTFILES directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
EXT_FILE="$DOTFILES/modules/antigravity/files/extensions.txt"

# Fallback if script is run directly from symlink in ~/.local/bin
if [[ ! -f "$EXT_FILE" ]]; then
	REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
	REAL_DIR="$(dirname "$REAL_PATH")"
	DOTFILES="$(cd "$REAL_DIR/../../../.." && pwd)"
	EXT_FILE="$DOTFILES/modules/antigravity/files/extensions.txt"
fi

get_antigravity_bin() {
	if command -v antigravity-ide >/dev/null 2>&1; then
		echo "antigravity-ide"
	elif [[ -x "/opt/antigravity-ide/bin/antigravity-ide" ]]; then
		echo "/opt/antigravity-ide/bin/antigravity-ide"
	elif command -v antigravity >/dev/null 2>&1; then
		echo "antigravity"
	else
		echo ""
	fi
}

function get_installed_extensions() {
	local bin
	bin="$(get_antigravity_bin)"
	if [[ -z "$bin" ]]; then
		echo "Error: Antigravity IDE CLI not found in PATH or /opt/antigravity-ide/bin." >&2
		exit 1
	fi

	"$bin" --list-extensions 2>&1 | \
		grep -E '^[a-zA-Z0-9_.-]+\.[a-zA-Z0-9_.-]+$' | \
		grep -v 'noctalia\.noctaliatheme' | \
		sort -u
}

function export_extensions() {
	echo "Syncing installed Antigravity IDE extensions -> $EXT_FILE..."
	local current_exts
	current_exts="$(get_installed_extensions)"

	if [[ -z "$current_exts" ]]; then
		echo "Warning: No extensions found from Antigravity IDE." >&2
		exit 1
	fi

	local count
	count="$(echo "$current_exts" | wc -l)"

	mkdir -p "$(dirname "$EXT_FILE")"
	echo "$current_exts" > "$EXT_FILE"
	echo "✓ Updated $EXT_FILE ($count extensions saved)."
}

function install_extensions() {
	if [[ ! -f "$EXT_FILE" ]]; then
		echo "Error: $EXT_FILE does not exist." >&2
		exit 1
	fi

	local bin
	bin="$(get_antigravity_bin)"
	if [[ -z "$bin" ]]; then
		echo "Warning: Antigravity IDE CLI not found in PATH or /opt/antigravity-ide/bin. Skipping." >&2
		return 0
	fi

	echo "Installing extensions from $EXT_FILE -> Antigravity IDE..."
	local installed
	installed="$(get_installed_extensions || true)"

	while read -r ext; do
		[[ -z "$ext" || "$ext" =~ ^# ]] && continue
		if ! echo "$installed" | grep -Fqi "$ext"; then
			echo "Installing: $ext"
			"$bin" --install-extension "$ext" || true
		else
			echo "Already installed: $ext"
		fi
	done < "$EXT_FILE"
	echo "✓ Installation complete."
}

case "${1:-dump}" in
	dump|save|export)
		export_extensions
		;;
	install|load|apply|-i|--install)
		install_extensions
		;;
	-h|--help|help)
		echo "Usage: $(basename "$0") [dump|install]"
		echo ""
		echo "Commands:"
		echo "  dump, save, export    (Default) Save installed Antigravity IDE extensions to dotfiles"
		echo "  install, load, apply  Install all extensions listed in dotfiles to Antigravity IDE"
		;;
	*)
		export_extensions
		;;
esac
