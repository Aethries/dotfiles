# ==============================================================================
# Ghostty Terminal Configuration
# Wayland & Umbriel Compositor + Noctalia Ecosystem
# ==============================================================================

# ------------------------------------------------------------------------------
# Typography
# ------------------------------------------------------------------------------
font-family = "JetBrainsMono Nerd Font"
font-size = 9.5
font-feature = +calt
font-feature = +liga
font-feature = +dlig
adjust-cell-height = 10%

# ------------------------------------------------------------------------------
# Window Design & Geometry
# ------------------------------------------------------------------------------
window-decoration = false
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
window-padding-color = extend-always
confirm-close-surface = false
quit-after-last-window-closed = true

# ------------------------------------------------------------------------------
# Transparency & Compositor Blur
# ------------------------------------------------------------------------------
background-opacity = 0.78
background-blur = true
unfocused-split-opacity = 0.85

# ------------------------------------------------------------------------------
# Cursor Rendering
# ------------------------------------------------------------------------------
cursor-style = bar
cursor-style-blink = false
adjust-cursor-thickness = 1
# The shader draws the focused caret; hide the native one to avoid double cursors.
cursor-opacity = 0
# Shader colors use linear RGB, matching Ghostty's Linux renderer.
alpha-blending = linear-corrected
custom-shader = shaders/cursor-glide.glsl
# Animate focused surfaces only; "always" also redraws inactive windows.
custom-shader-animation = true

# ------------------------------------------------------------------------------
# Shell & Multiplexer Integration
# ------------------------------------------------------------------------------
# Single-surface architecture: Ghostty acts as pure GPU UI renderer / aesthetic wrapper.
# All splits, tabs, sessions and pane management are handled 100% by Zellij.
command = /bin/bash -c "exec $HOME/.config/zellij/scripts/launcher.sh"
window-inherit-working-directory = false

# ------------------------------------------------------------------------------
# Shortcuts & Keybindings
# ------------------------------------------------------------------------------
# Clipboard & Font scaling only
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+alt+equal=increase_font_size:1
keybind = ctrl+alt+minus=decrease_font_size:1
keybind = ctrl+alt+zero=reset_font_size

# Unbind ALL native Ghostty splits, tabs, and window actions (pure wrapper)
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+enter=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+d=unbind
# Forward Zellij's session manager and floating-pane controls instead of splitting.
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+s=unbind
keybind = ctrl+shift+j=unbind
keybind = ctrl+shift+k=unbind
keybind = ctrl+shift+h=unbind
keybind = ctrl+shift+l=unbind
keybind = ctrl+shift+left=unbind
keybind = ctrl+shift+right=unbind
keybind = ctrl+shift+up=unbind
keybind = ctrl+shift+down=unbind
keybind = super+t=unbind
keybind = super+w=unbind
keybind = super+n=unbind
keybind = super+enter=unbind
keybind = super+shift+w=unbind
keybind = super+shift+enter=unbind

# ------------------------------------------------------------------------------
# Palette & Colors (Noctalia Dynamic Theme)
# ------------------------------------------------------------------------------
theme = noctalia
# Cursor color comes from the Noctalia theme. Keep glyphs readable when a TUI
# requests a block cursor, even though its native background is transparent.
cursor-text = cell-foreground

# ------------------------------------------------------------------------------
# Performance & Features
# ------------------------------------------------------------------------------
mouse-hide-while-typing = true
auto-update = off

