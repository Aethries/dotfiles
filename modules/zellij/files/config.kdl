// =============================================================================
// Zellij Configuration
// Single-surface architecture: Kitty renders UI, Zellij manages all tabs/panes
// =============================================================================

keybinds clear-defaults=true {
	normal {
		// --- Tab Management (Ctrl+Shift to protect shell Ctrl keys) ---
		bind "Ctrl Shift t" { NewTab; }
		bind "Ctrl Shift w" { CloseFocus; }
		bind "Ctrl Shift q" { CloseTab; }
		bind "Ctrl Shift r" { SwitchToMode "RenameTab"; TabNameInput 0; }
		bind "Ctrl Shift [" { GoToPreviousTab; }
		bind "Ctrl Shift ]" { GoToNextTab; }
		bind "Ctrl Shift 1" { GoToTab 1; }
		bind "Ctrl Shift 2" { GoToTab 2; }
		bind "Ctrl Shift 3" { GoToTab 3; }
		bind "Ctrl Shift 4" { GoToTab 4; }
		bind "Ctrl Shift 5" { GoToTab 5; }
		bind "Ctrl Shift 6" { GoToTab 6; }
		bind "Ctrl Shift 7" { GoToTab 7; }
		bind "Ctrl Shift 8" { GoToTab 8; }
		bind "Ctrl Shift 9" { GoToTab 9; }

		// --- Pane Management (Vertical Split Only, No Horizontal Split) ---
		bind "Ctrl Shift n" "Ctrl Shift \\" { NewPane "Right"; }
		bind "Ctrl Shift f" { ToggleFocusFullscreen; }
		bind "Ctrl Shift e" { TogglePaneEmbedOrFloating; }
		bind "Ctrl Shift p" { ToggleFloatingPanes; }

		// --- Seamless Neovim / Zellij Pane Navigation ---
		bind "Ctrl h" {
			MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
				name "move_focus_or_tab";
				payload "left";
				move_mod "ctrl";
			};
		}
		bind "Ctrl j" {
			MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
				name "move_focus";
				payload "down";
				move_mod "ctrl";
			};
		}
		bind "Ctrl k" {
			MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
				name "move_focus";
				payload "up";
				move_mod "ctrl";
			};
		}
		bind "Ctrl l" {
			MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
				name "move_focus_or_tab";
				payload "right";
				move_mod "ctrl";
			};
		}

		// --- Move / Swap Panes (Unified Shift) ---
		bind "Ctrl Shift h" "Ctrl Shift Left" { MovePane "Left"; }
		bind "Ctrl Shift l" "Ctrl Shift Right" { MovePane "Right"; }
		bind "Ctrl Shift j" "Ctrl Shift Down" { MovePane "Down"; }
		bind "Ctrl Shift k" "Ctrl Shift Up" { MovePane "Up"; }

		// --- Resize Panes ---
		bind "Ctrl Shift =" "Ctrl Shift +" { Resize "Increase"; }
		bind "Ctrl Shift -" { Resize "Decrease"; }

		// --- Layout & View ---
		bind "Ctrl Shift Space" { NextSwapLayout; }

		// --- Search & Scroll ---
		bind "Ctrl Shift s" { SwitchToMode "EnterSearch"; SearchInput 0; }
		bind "Ctrl Shift b" { SwitchToMode "Scroll"; }

		// --- Session Management ---
		bind "Ctrl Shift d" { Detach; }
		bind "Ctrl Shift o" {
			LaunchOrFocusPlugin "session-manager" {
				floating true
				move_to_focused_tab true
			}
		}

		// --- Safety / Mode Switch ---
		bind "Ctrl g" { SwitchToMode "Locked"; }
	}

	locked {
		bind "Ctrl g" { SwitchToMode "Normal"; }
	}

	scroll {
		bind "Esc" "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
		bind "j" "Down" { ScrollDown; }
		bind "k" "Up" { ScrollUp; }
		bind "d" { HalfPageScrollDown; }
		bind "u" { HalfPageScrollUp; }
		bind "PageDown" { PageScrollDown; }
		bind "PageUp" { PageScrollUp; }
		bind "g" { ScrollToTop; }
		bind "G" { ScrollToBottom; }
		bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
		bind "e" { EditScrollback; SwitchToMode "Normal"; }
	}

	entersearch {
		bind "Esc" "Ctrl c" { SwitchToMode "Scroll"; }
		bind "Enter" { SwitchToMode "Search"; }
	}

	search {
		bind "Esc" "Ctrl c" { SwitchToMode "Normal"; }
		bind "n" { Search "down"; }
		bind "p" { Search "up"; }
		bind "c" { SearchToggleOption "CaseSensitivity"; }
		bind "w" { SearchToggleOption "Wrap"; }
		bind "o" { SearchToggleOption "WholeWord"; }
	}

	renametab {
		bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
		bind "Enter" "Ctrl c" { SwitchToMode "Normal"; }
	}

	renamepane {
		bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
		bind "Enter" "Ctrl c" { SwitchToMode "Normal"; }
	}
}

// -----------------------------------------------------------------------------
// UI Settings
// -----------------------------------------------------------------------------
default_layout "default"
default_shell "zsh"
theme "noctalia"

simplified_ui false
pane_frames true
ui {
	pane_frames {
		rounded_corners true
		hide_session_name false
	}
}

mouse_mode true
copy_on_select true
scroll_buffer_size 10000
show_startup_tips false
show_release_notes false
auto_layout true

// Protocols
support_kitty_keyboard_protocol true

// Session resurrection & persistence
on_force_close "detach"
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 2000
