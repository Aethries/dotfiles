#!/usr/bin/env bash
# ==============================================================================
# System Cheatsheet: Tra cứu phím tắt hệ thống phân cấp (Bilingual VI/EN)
# Sử dụng FZF trong cửa sổ Kitty nổi, hỗ trợ gõ tiếng Việt Fcitx5
# ==============================================================================
set -euo pipefail

# Tự động định vị thư mục thực của script (hỗ trợ cả khi chạy qua symlink)
REAL_SCRIPT="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"

# Tìm file dữ liệu động: ưu tiên XDG config, fallback sang cùng thư mục script
DATA_FILE=""
CANDIDATE_PATHS=(
	"${XDG_CONFIG_HOME:-$HOME/.config}/cheatsheet/keymaps.tsv"
	"$SCRIPT_DIR/keymaps.tsv"
)

for p in "${CANDIDATE_PATHS[@]}"; do
	if [[ -f "$p" ]]; then
		DATA_FILE="$p"
		break
	fi
done

if [[ -z "$DATA_FILE" ]]; then
	echo "Lỗi: Không tìm thấy file dữ liệu keymaps.tsv!" >&2
	exit 1
fi

# Chạy trong Ghostty nổi nếu được gọi từ desktop/compositor (không có TTY)
if [[ "${1:-}" != "--tui" ]] && [[ ! -t 0 || ! -t 1 ]]; then
	exec ghostty --class=sys-cheatsheet \
		--title="Bảng Tra Cứu Phím Tắt Hệ Thống (System Cheatsheet)" \
		-e "$0" --tui "$@"
fi

if [[ "${1:-}" == "--tui" ]]; then
	shift
fi

# Preview script nội tuyến để format chi tiết cho fzf preview
export DATA_FILE
preview_cmd='
line="{}"
key=$(echo "$line" | awk -F"\t" "{print \$2}")
cat=$(echo "$line" | awk -F"\t" "{print \$1}")
vi=$(echo "$line" | awk -F"\t" "{print \$3}")
en=$(echo "$line" | awk -F"\t" "{print \$4}")
layer=$(echo "$line" | awk -F"\t" "{print \$5}")
cfg=$(echo "$line" | awk -F"\t" "{print \$6}")

echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e " \033[1;33m󰌌 PHÍM TẮT:\033[0m   \033[1;32m$key\033[0m"
echo -e " \033[1;34m PHÂN TẦNG:\033[0m \033[1;37m$layer\033[0m (\033[36m$cat\033[0m)"
echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
echo -e "\033[1;33m🇻🇳 TIẾNG VIỆT:\033[0m"
echo -e "   $vi"
echo ""
echo -e "\033[1;34m🇬🇧 TIẾNG ANH:\033[0m"
echo -e "   $en"
echo ""
echo -e "\033[1;35m FILE CẤU HÌNH:\033[0m"
echo -e "   \033[3m$cfg\033[0m"
echo ""
echo -e "\033[1;30m─────────────────────────────────────────────────────\033[0m"
echo -e "\033[0;33mEnter:\033[0m Sao chép phím vào Clipboard   \033[0;31mEsc / Ctrl+q:\033[0m Đóng"
'

# Xử lý dữ liệu bảng với fzf
selected=$(tail -n +2 "$DATA_FILE" | fzf \
	--delimiter=$'\t' \
	--with-nth=1,2,3,4 \
	--ansi \
	--prompt="󰌌 Tìm kiếm phím tắt > " \
	--header=$'Esc / Ctrl+q: Đóng │ Enter: Copy phím │ Ctrl+j/k: Di chuyển │ Ctrl+d/u: Cuộn trang\n─────────────────────────────────────────────────────────────────────────────' \
	--preview="$preview_cmd" \
	--preview-window="right:45%:wrap:border-left" \
	--bind="ctrl-j:down,ctrl-k:up,ctrl-d:preview-page-down,ctrl-u:preview-page-up,ctrl-q:abort" \
	--color="header:italic:underline,prompt:bold:yellow,pointer:bold:red" \
	--no-sort || true)

if [[ -n "$selected" ]]; then
	keybind=$(echo "$selected" | awk -F'\t' '{print $2}')
	action_vi=$(echo "$selected" | awk -F'\t' '{print $3}')
	
	if command -v wl-copy >/dev/null 2>&1; then
		echo -n "$keybind" | wl-copy
		if command -v notify-send >/dev/null 2>&1; then
			notify-send -a "Cheatsheet" "Đã sao chép phím tắt" "$keybind: $action_vi" -i input-keyboard 2>/dev/null || true
		fi
	fi
fi
