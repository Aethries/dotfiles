{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    },
    "color": {
      "1": "#63a5d7",
      "2": "#636bc7"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#75a5d7",
      "title": "#6b6bc7"
    },
    "key": {
      "width": 17
    },
    "percent": {
      "color": {
        "green": "#9970c2",
        "yellow": "#a1bfde",
        "red": "#fd4663"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#fabd2f",
        "at": "#d5c4a1",
        "host": "#b8bb26"
      }
    },
    "separator",
    {
      "type": "os",
      "key": "󰣇 OS"
    },
    {
      "type": "host",
      "key": "󰌢 Host"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel"
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "shell",
      "key": "󱆃 Shell"
    },
    {
      "type": "wm",
      "key": "󱂬 WM"
    },
    {
      "type": "terminal",
      "key": "󰞷 Terminal"
    },
    {
      "type": "display",
      "key": "󰍹 Display"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "󰑭 Memory"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk (/)",
      "folders": "/"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk (/home)",
      "folders": "/home"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
