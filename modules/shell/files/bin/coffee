#!/usr/bin/env bash
# ==============================================================================
# Coffee - Sleep Inhibitor Bridge (end4-pC Idle + systemd-inhibit fallback)
# ==============================================================================

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/coffee"
PID_FILE="$STATE_DIR/coffee.pid"
QS_CONFIG="${QS_CONFIG:-end4-pC}"
QS_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell/states.json"
mkdir -p "$STATE_DIR"

has_quickshell() {
	command -v qs >/dev/null 2>&1 && pgrep -x quickshell >/dev/null 2>&1
}

end4_idle() {
	local action="$1"
	qs -c "$QS_CONFIG" ipc call idle "$action" >/dev/null 2>&1
}

quickshell_inhibited() {
	[[ -f "$QS_STATE" ]] || return 1
	if command -v jq >/dev/null 2>&1; then
		[[ "$(jq -r '.idle.inhibit // false' "$QS_STATE" 2>/dev/null)" == "true" ]]
	else
		grep -q '"inhibit": true' "$QS_STATE" 2>/dev/null
	fi
}

notify() {
	local title="$1"
	local msg="$2"
	echo "[$title] $msg"
	if command -v notify-send >/dev/null 2>&1; then
		notify-send -a "Coffee" "$title" "$msg" 2>/dev/null || true
	fi
}

is_active() {
	# Prefer the end4-pC idle inhibitor state.
	if has_quickshell && quickshell_inhibited; then
		return 0
	fi

	# Fallback: our own systemd-inhibit process.
	if command -v systemd-inhibit >/dev/null 2>&1; then
		if systemd-inhibit --list 2>/dev/null | grep -qi "coffee"; then
			return 0
		fi
	fi

	if [[ -f "$PID_FILE" ]]; then
		local pid
		pid="$(cat "$PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
		rm -f "$PID_FILE"
	fi

	return 1
}

start_coffee() {
	if is_active; then
		echo "Coffee is already ACTIVE."
		return 0
	fi

	if has_quickshell && end4_idle inhibit; then
		notify "Coffee Activated" "end4-pC idle inhibitor enabled (Wayland idle inhibited)."
		return 0
	fi

	systemd-inhibit \
		--what=idle:sleep:shutdown \
		--who="coffee" \
		--why="Workstation keep-awake" \
		--mode=block \
		sleep infinity >/dev/null 2>&1 &

	local pid=$!
	echo "$pid" > "$PID_FILE"
	notify "Coffee Activated" "systemd-inhibit active (PID: $pid)."
}

stop_coffee() {
	local was_active=false
	if is_active; then
		was_active=true
	fi

	if has_quickshell; then
		end4_idle uninhibit || true
	fi

	if [[ -f "$PID_FILE" ]]; then
		local pid
		pid="$(cat "$PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]]; then
			kill "$pid" 2>/dev/null || true
		fi
		rm -f "$PID_FILE"
	fi

	if [[ "$was_active" == "true" ]]; then
		notify "Coffee Deactivated" "Sleep inhibition disabled (normal sleep restored)."
	else
		echo "Coffee is already INACTIVE."
	fi
}

toggle_coffee() {
	if has_quickshell && end4_idle toggle; then
		if quickshell_inhibited; then
			notify "Coffee" "Idle inhibition ON"
		else
			notify "Coffee" "Idle inhibition OFF"
		fi
		return 0
	fi

	if is_active; then
		stop_coffee
	else
		start_coffee
	fi
}

status_coffee() {
	if is_active; then
		echo "Status: ACTIVE"
		if has_quickshell && quickshell_inhibited; then
			echo "Source: end4-pC idle inhibitor"
		fi
		if command -v systemd-inhibit >/dev/null 2>&1; then
			systemd-inhibit --list | grep -i "coffee" || true
		fi
	else
		echo "Status: INACTIVE (Normal power profile)"
	fi
}

timed_coffee() {
	local duration="$1"
	echo "Brewing coffee for $duration..."
	notify "Coffee Started" "Inhibiting sleep for $duration..."

	if has_quickshell && end4_idle inhibit; then
		sleep "$duration"
		end4_idle uninhibit || true
	else
		systemd-inhibit \
			--what=idle:sleep:shutdown \
			--who="coffee" \
			--why="Workstation keep-awake ($duration)" \
			--mode=block \
			sleep "$duration"
	fi

	notify "Coffee Expired" "Timed keep-awake completed. Sleep restored."
}

case "${1:-status}" in
	on|start)
		start_coffee
		;;
	off|stop)
		stop_coffee
		;;
	toggle)
		toggle_coffee
		;;
	status)
		status_coffee
		;;
	run|exec)
		shift
		if [[ $# -eq 0 ]]; then
			echo "Usage: coffee run <command...>"
			exit 1
		fi
		echo "Running under sleep inhibitor: $*"
		exec systemd-inhibit \
			--what=idle:sleep:shutdown \
			--who="coffee" \
			--why="Running $*" \
			--mode=block \
			"$@"
		;;
	*)
		if [[ "$1" =~ ^[0-9]+[smhd]?$ ]]; then
			timed_coffee "$1"
		else
			echo "Usage: coffee [on|off|toggle|status|<duration>|run <command>]"
			exit 1
		fi
		;;
esac
