[Unit]
Description=9router Local AI Gateway & Proxy Service
After=default.target

[Service]
Type=simple
Environment="NODE_EXTRA_CA_CERTS=%h/.9router/mitm/rootCA.crt"
Environment="PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStartPre=/bin/bash -c 'if command -v mise >/dev/null 2>&1; then eval "$(mise activate bash)"; elif test -r /usr/share/nvm/init-nvm.sh; then . /usr/share/nvm/init-nvm.sh; elif test -s %h/.nvm/nvm.sh; then . %h/.nvm/nvm.sh; fi; command -v 9router >/dev/null 2>&1 || (echo "9router binary not found" >&2; exit 1)'
ExecStart=/bin/bash -c 'if command -v mise >/dev/null 2>&1; then eval "$(mise activate bash)"; elif test -r /usr/share/nvm/init-nvm.sh; then . /usr/share/nvm/init-nvm.sh; elif test -s %h/.nvm/nvm.sh; then . %h/.nvm/nvm.sh; fi; exec 9router --skip-update --port 20128 --host 127.0.0.1'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
