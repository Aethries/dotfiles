# ==============================================================================
# Tailscale SSH & Multiplexing Client Configuration
# ==============================================================================

# Enable connection multiplexing and keepalive across all remote hosts
Host *
	ServerAliveInterval 15
	ServerAliveCountMax 3
	ControlMaster auto
	ControlPath ~/.ssh/sockets/%r@%h:%p
	ControlPersist 10m
	StrictHostKeyChecking accept-new
