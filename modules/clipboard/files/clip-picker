#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/go/bin:/usr/local/bin:/usr/bin:$PATH"

# Ensure clipse listener is running
if ! pgrep -f "clipse --wl-store" >/dev/null 2>&1; then
	clipse -listen >/dev/null 2>&1 || systemctl --user start clipse.service 2>/dev/null || true
fi

exit_file="/tmp/clipse_status_$$"
rm -f "$exit_file"

# Launch Clipse floating in Ghostty and capture exit code
ghostty --class=clipse --title="Clipboard Manager" \
	-e sh -c 'clipse "$@"; echo "$?" > "'"$exit_file"'"' -- "$@"

# Auto-paste ONLY when user chose an item with Enter (exit status == 0)
if [[ -f "$exit_file" ]]; then
	exit_code="$(cat "$exit_file" 2>/dev/null || echo 1)"
	rm -f "$exit_file"
	if [[ "$exit_code" -eq 0 ]] && command -v wtype >/dev/null 2>&1; then
		sleep 0.1
		wtype -M ctrl -k v -m ctrl 2>/dev/null || true
	fi
fi
