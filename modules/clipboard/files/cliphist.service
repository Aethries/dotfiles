[Unit]
Description=Cliphist Clipboard History Watcher
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:%h/go/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/bin/sh -c 'exec wl-paste --watch cliphist store'
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
