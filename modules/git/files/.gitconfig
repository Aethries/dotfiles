[core]
	editor = nvim
	pager = delta
	autocrlf = input
	quotepath = false
	hooksPath = ~/.config/git/hooks

[credential]
	helper = /usr/lib/git-core/git-credential-libsecret

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	line-numbers = true
	side-by-side = false
	syntax-theme = Dracula

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

# Nạp thông tin định danh cá nhân và cấu hình riêng từng máy (bảo mật, untracked)
[include]
	path = ~/.gitconfig.local
