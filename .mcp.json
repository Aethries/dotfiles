{
  "mcpServers": {
    "agentmemory": {
      "command": "npx",
      "args": ["-y", "@agentmemory/mcp@0.9.29"],
      "env": {
        "AGENTMEMORY_URL": "http://127.0.0.1:3111"
      }
    },
    "jev-local": {
      "command": "bash",
      "args": ["scripts/jev-mcp.sh"],
      "env": {
        "JEV_ENDPOINT": "http://localhost:20128/v1/systemone",
        "JEV_MODEL": "oc/jev-1.13-free"
      }
    }
  }
}
