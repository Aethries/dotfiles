[Unit]
Description=9router Local AI Gateway & Proxy Service
# User services cannot depend on system targets like network-online.target.
# Use After=default.target which is the correct anchor for user session services.
After=default.target

[Service]
Type=simple
# fnm puts node binaries under ~/.local/share/fnm/aliases/default/bin (or similar).
# We include common fnm paths + nix profile paths so 'node' is always found.
Environment="PATH=%h/.local/bin:%h/.local/share/fnm/aliases/default/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/wrappers/bin:/run/current-system/sw/bin"
Environment="NODE_EXTRA_CA_CERTS=%h/.9router/mitm/rootCA.crt"
Environment="NODE_PATH=%h/.local/lib/node_modules"
# Resolve the fnm-managed node at runtime so the path is always current.
ExecStartPre=/bin/sh -c 'test -x "${HOME}/.local/bin/9router" || (echo "9router binary not found at ~/.local/bin/9router. Run init-9router first." >&2; exit 1)'
# --tray requires a running compositor/display. Omit it here; the tray icon
# can be launched separately once the desktop session is fully up.
# 9Router is a local gateway; keep both its port and bind address explicit.
ExecStart=%h/.local/bin/9router --skip-update --port 20128 --host 127.0.0.1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
