{
  "$schema": "vscode://schemas/color-theme",
  "name": "NoctaliaTheme",
  "type": "dark",
  "colors": {
    "editor.background": "#151b28",
    "editor.foreground": "#f2f2f3",
    "activityBar.background": "#151b28",
    "sideBar.background": "#1f283c",
    "statusBar.background": "#151b28",
    "editorGroupHeader.tabsBackground": "#151b28",
    "tab.activeBackground": "#1f283c",
    "tab.inactiveBackground": "#151b28"
  },
  "tokenColors": [
    {
      "scope": ["comment"],
      "settings": { "foreground": "#616771", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage"],
      "settings": { "foreground": "#9785e1" }
    },
    {
      "scope": ["string"],
      "settings": { "foreground": "#7e9fe8" }
    }
  ]
}
