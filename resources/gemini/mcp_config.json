{
  "mcpServers": {
    "godot": {
      "command": "godot-mcp",
      "args": [],
      "env": {
        "GODOT_PATH": "godot"
      }
    },
    "codebase-memory": {
      "command": "codebase-memory-mcp",
      "args": []
    },
    "codegraph": {
      "command": "codebase-memory-mcp",
      "args": []
    },
    "agentmemory": {
      "command": "npx",
      "args": ["-y", "@agentmemory/mcp@0.9.29"],
      "env": {
        "AGENTMEMORY_URL": "http://127.0.0.1:3111"
      }
    },
    "jira": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.atlassian.com/v2/mcp"]
    },
    "jev-local": {
      "command": "/home/loc/Workspaces/dotfiles/scripts/jev-mcp.sh",
      "args": [],
      "env": {
        "JEV_ENDPOINT": "http://localhost:20128/v1/systemone",
        "JEV_MODEL": "oc/jev-1.13-free"
      }
    }
  }
}
