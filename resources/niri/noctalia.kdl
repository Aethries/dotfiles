layout {

    focus-ring {
        active-color   "#67b8e4"
        inactive-color "#152128"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67b8e4"
        inactive-color "#152128"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#67b8e4"
        inactive-color "#145d85"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67b8e480"
    }
}

recent-windows {
    highlight {
        active-color "#67b8e4"
        urgent-color "#fd4663"
    }
}
