# Repo-owned, secret-free defaults for agentmemory.dev.
# API keys and AGENTMEMORY_SECRET must stay outside this file.
AGENTMEMORY_PACKAGE_VERSION=0.9.29
AGENTMEMORY_URL=http://127.0.0.1:3111
AGENTMEMORY_VIEWER_URL=http://127.0.0.1:3113
AGENTMEMORY_DATA_DIR=/var/lib/agentmemory
AGENTMEMORY_III_VERSION=0.11.2

# Keyless mode is intentional. The server still provides BM25 recall and the
# full MCP surface; embeddings/LLM compression can be enabled out-of-band.
AGENTMEMORY_INJECT_CONTEXT=false
AGENTMEMORY_AUTO_COMPRESS=false
EMBEDDING_PROVIDER=none
