;; ==============================================================================
;; Kanata Configuration: Multi-Layer Modal Workstation Keymap
;; Reference: Issue #81 & docs/keymap-architecture.md
;;
;; Layers:
;;   - normal:      Default physical keyboard typing.
;;                  Hold CapsLock (200ms) -> Switch to navigate layer.
;;                  Hold RightShift (200ms) -> Switch to super layer.
;;   - navigate:    Neovim cursor & word motions, tab & browser navigation.
;;                  Press 1 -> Switch to niri layer.
;;                  Press Esc -> Switch to normal layer.
;;   - super:       One-shot 1s modifiers (Super, Shift, Ctrl, Alt).
;;                  Press c -> Lock Ctrl indefinitely until Esc.
;;                  Press Esc -> Switch to normal layer.
;;   - niri:        Window & workspace management for Niri Wayland Compositor.
;;                  One-shot actions (c, p, s, r, d, t, ret, o, v) -> execute & return to normal.
;;                  Persistent actions (f, q, h, j, k, l, 1-9) -> stay in niri layer.
;;                  Press Esc -> Switch to normal layer.
;;   - ctrl_locked: Emits Ctrl+<key> for every key until Esc cancels back to normal.
;;   - bypass:      Hardware pass-through (LShift + RShift chord).
;; ==============================================================================

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    apos ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
  ;; --------------------------------------------------------------------------
  ;; Layer Switching Aliases
  ;; --------------------------------------------------------------------------
  to_norm (layer-switch normal)
  to_nav  (layer-switch navigate)
  to_sup  (layer-switch super)
  to_niri (layer-switch niri)
  to_clk  (layer-switch ctrl_locked)
  to_slk  (layer-switch super_locked)
  to_alk  (layer-switch alt_locked)
  to_shlk (layer-switch shift_locked)
  to_bp   (layer-switch bypass)

  ;; Normal mode Esc: cancels all active/waiting modifiers cleanly
  esc_norm (multi (release-key lmet) (release-key lctl) (release-key lalt) (release-key lsft) esc)

  ;; Transitions that switch layer without consuming waiting one-shot modifiers
  nav_preserve  (multi (one-shot-pause-processing 100) @to_nav)
  norm_preserve (multi (one-shot-pause-processing 100) @to_norm)

  ;; Normal mode triggers:
  ;; CapsLock switches to navigate layer preserving waiting modifiers.
  ;; Shift + CapsLock triggers real CapsLock hardware toggle if needed.
  caps_to_nav (fork @nav_preserve caps (lsft rsft))
  rsft_to_sup (tap-hold-release 200 200 rsft @to_sup)

  ;; --------------------------------------------------------------------------
  ;; Navigate Layer Actions
  ;; --------------------------------------------------------------------------
  ;; h/j/k/l: Arrows alone; with Ctrl -> Tab/Page motions
  h_nav (fork left (multi lctl lsft tab) (lctl rctl))
  l_nav (fork rght (multi lctl tab) (lctl rctl))
  j_nav (fork down C-pgdn (lctl rctl))
  k_nav (fork up   C-pgup (lctl rctl))

  ;; d/u: PageDown / PageUp (with Ctrl -> C-pgdn / C-pgup)
  d_nav (fork pgdn C-pgdn (lctl rctl))
  u_nav (fork pgup C-pgup (lctl rctl))

  ;; o/i: Jump Backward (Alt+Left) / Forward (Alt+Right).
  ;; i alone returns to normal mode preserving waiting modifiers.
  o_nav (fork o A-left (lctl rctl))
  i_nav (fork @norm_preserve A-rght (lctl rctl))

  ;; Word & Line motions
  w_fwd C-rght
  w_bwd C-left
  key_4 (fork 4 end (lsft rsft))

  ;; --------------------------------------------------------------------------
  ;; Super Layer Actions (One-Shot Modifiers & Sticky Locks with Shift)
  ;; --------------------------------------------------------------------------
  os_super (one-shot 2000 lmet)
  os_shift (one-shot 2000 lsft)
  os_ctrl  (one-shot 2000 lctl)
  os_alt   (one-shot 2000 lalt)

  ;; Pressing key alone -> One-shot for next key only
  ;; Pressing Shift + key -> Sticky lock modifier indefinitely until Esc
  sup_a (fork @os_super @to_slk  (lsft rsft))
  sup_s (fork @os_shift @to_shlk (lsft rsft))
  sup_d (fork @os_ctrl  @to_clk  (lsft rsft))
  sup_f (fork @os_alt   @to_alk  (lsft rsft))

  ;; --------------------------------------------------------------------------
  ;; Niri Layer Actions
  ;; --------------------------------------------------------------------------
  ;; h/l: Focus column (with Ctrl -> move column, with Shift -> focus monitor, with Alt -> move to monitor)
  h_niri (fork M-h (fork C-M-h (fork S-M-h (multi lmet lctl lsft h) (lalt ralt)) (lsft rsft)) (lctl rctl))
  l_niri (fork M-l (fork C-M-l (fork S-M-l (multi lmet lctl lsft l) (lalt ralt)) (lsft rsft)) (lctl rctl))

  ;; j/k: Focus workspace (with Ctrl -> move column to workspace)
  j_niri (fork M-j C-M-j (lctl rctl))
  k_niri (fork M-k C-M-k (lctl rctl))

  ;; 1-9: Move to workspace 1-9 (with Ctrl -> move window to workspace 1-9)
  n1 (fork M-1 C-M-1 (lctl rctl))
  n2 (fork M-2 C-M-2 (lctl rctl))
  n3 (fork M-3 C-M-3 (lctl rctl))
  n4 (fork M-4 C-M-4 (lctl rctl))
  n5 (fork M-5 C-M-5 (lctl rctl))
  n6 (fork M-6 C-M-6 (lctl rctl))
  n7 (fork M-7 C-M-7 (lctl rctl))
  n8 (fork M-8 C-M-8 (lctl rctl))
  n9 (fork M-9 C-M-9 (lctl rctl))

  ;; One-shot actions that automatically return to normal mode
  niri_center (multi M-c @to_norm)
  niri_proj   (multi M-p @to_norm)
  niri_shot   (multi M-s @to_norm)
  niri_rec    (multi M-r @to_norm)
  niri_menu   (multi M-d @to_norm)
  niri_term   (multi M-ret @to_norm)
  niri_over   (multi M-o @to_norm)
  niri_clip   (multi M-v @to_norm)
)

;; ----------------------------------------------------------------------------
;; 1. Normal Layer (Default Physical Typing)
;; ----------------------------------------------------------------------------
(deflayer normal
  @esc_norm f1 f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @caps_to_nav a s d  f    g    h    j    k    l    ;    apos ret
  lsft z    x    c    v    b    n    m    ,    .    /    @rsft_to_sup
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 2. Navigate Layer (Vim Motions & Tab/Word Controls)
;; ----------------------------------------------------------------------------
(deflayer navigate
  @norm_preserve f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  @to_niri 2    3    @key_4 5  6    7    8    9    home -    =    bspc
  tab  q    @w_fwd @w_bwd C-y  t    C-c  @u_nav @i_nav @o_nav C-v [   ]   \
  @norm_preserve C-a s    @d_nav f  g    @h_nav @j_nav @k_nav @l_nav ; apos ret
  lsft C-z  del  c    v    @w_bwd n  m    ,    .    C-f  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 3. Super Layer (One-Shot Modifiers & Sticky Locks)
;; ----------------------------------------------------------------------------
(deflayer super
  @norm_preserve f1 f2 f3 f4  f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    @norm_preserve o p [ ]   \
  @norm_preserve @sup_a @sup_s @sup_d @sup_f g h j k l ; apos ret
  lsft z    x    @to_clk v b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 4. Niri Layer (Window & Workspace Management)
;; ----------------------------------------------------------------------------
(deflayer niri
  @norm_preserve f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  @n1  @n2  @n3  @n4  @n5  @n6  @n7  @n8  @n9  M-0  M--  M-=  bspc
  @niri_over M-q w e  @niri_rec @niri_term y u @norm_preserve o @niri_proj [ ] \
  @norm_preserve a    @niri_shot @niri_menu M-f g @h_niri @j_niri @k_niri @l_niri ; apos @niri_term
  lsft z    x    @niri_center @niri_clip b n m , . / rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 5. Ctrl Locked Layer (Sticky Ctrl until Esc or Caps)
;; ----------------------------------------------------------------------------
(deflayer ctrl_locked
  @to_norm f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  C-1  C-2  C-3  C-4  C-5  C-6  C-7  C-8  C-9  C-0  C--  C-=  bspc
  tab  C-q  C-w  C-e  C-r  C-t  C-y  C-u  C-i  C-o  C-p  C-[  C-]  C-\
  @to_norm C-a C-s  C-d  C-f  C-g  C-h  C-j  C-k  C-l  C-;  apos ret
  lsft C-z  C-x  C-c  C-v  C-b  C-n  C-m  C-,  C-.  C-/  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 6. Super Locked Layer (Sticky Super/Win until Esc or Caps)
;; ----------------------------------------------------------------------------
(deflayer super_locked
  @to_norm f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  M-1  M-2  M-3  M-4  M-5  M-6  M-7  M-8  M-9  M-0  M--  M-=  bspc
  tab  M-q  M-w  M-e  M-r  M-t  M-y  M-u  M-i  M-o  M-p  M-[  M-]  M-\
  @to_norm M-a M-s  M-d  M-f  M-g  M-h  M-j  M-k  M-l  M-;  apos ret
  lsft M-z  M-x  M-c  M-v  M-b  M-n  M-m  M-,  M-.  M-/  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 7. Alt Locked Layer (Sticky Alt until Esc or Caps)
;; ----------------------------------------------------------------------------
(deflayer alt_locked
  @to_norm f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  A-1  A-2  A-3  A-4  A-5  A-6  A-7  A-8  A-9  A-0  A--  A-=  bspc
  tab  A-q  A-w  A-e  A-r  A-t  A-y  A-u  A-i  A-o  A-p  A-[  A-]  A-\
  @to_norm A-a A-s  A-d  A-f  A-g  A-h  A-j  A-k  A-l  A-;  apos ret
  lsft A-z  A-x  A-c  A-v  A-b  A-n  A-m  A-,  A-.  A-/  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 8. Shift Locked Layer (Sticky Shift until Esc or Caps)
;; ----------------------------------------------------------------------------
(deflayer shift_locked
  @to_norm f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  S--  S-=  bspc
  tab  S-q  S-w  S-e  S-r  S-t  S-y  S-u  S-i  S-o  S-p  S-[  S-]  S-\
  @to_norm S-a S-s  S-d  S-f  S-g  S-h  S-j  S-k  S-l  S-;  apos ret
  lsft S-z  S-x  S-c  S-v  S-b  S-n  S-m  S-,  S-.  S-/  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 9. Bypass Layer (Raw 1:1 Hardware Passthrough)
;; ----------------------------------------------------------------------------
(deflayer bypass
  @to_norm f1 f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    apos ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)
