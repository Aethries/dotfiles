;; ==============================================================================
;; Kanata Configuration: Multi-Layer Modal Workstation Keymap
;; Reference: Issue #81 & docs/keymap-architecture.md
;;
;; Layers:
;;   - normal:      Default physical keyboard typing.
;;                  Hold CapsLock (200ms) -> Switch to navigate layer.
;;                  Hold RightShift (200ms) -> Switch to super layer.
;;   - navigate:    Neovim cursor & word motions, tab & browser navigation.
;;                  Press 1 -> Switch to niri layer.
;;                  Press Esc -> Switch to normal layer.
;;   - super:       One-shot 1s modifiers (Super, Shift, Ctrl, Alt).
;;                  Press c -> Lock Ctrl indefinitely until Esc.
;;                  Press Esc -> Switch to normal layer.
;;   - niri:        Window & workspace management for Niri Wayland Compositor.
;;                  One-shot actions (c, p, s, r, d, t, ret, o, v) -> execute & return to normal.
;;                  Persistent actions (f, q, h, j, k, l, 1-9) -> stay in niri layer.
;;                  Press Esc -> Switch to normal layer.
;;   - ctrl_locked: Emits Ctrl+<key> for every key until Esc cancels back to normal.
;;   - bypass:      Hardware pass-through (LShift + RShift chord).
;; ==============================================================================

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  sequence-timeout 1000
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    apos ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
  ;; --------------------------------------------------------------------------
  ;; Layer Switching Aliases
  ;; --------------------------------------------------------------------------
  ;; Kill Warpd pointer emulation synchronously when entering any keyboard mode
  kill_warpd (multi (release-key lsft) (release-key rsft) (macro M-A-esc 50))

  to_norm (layer-switch normal)
  to_nav  (multi @kill_warpd (layer-switch navigate))
  to_sup  (multi @kill_warpd (layer-switch super))
  to_niri (multi @kill_warpd (layer-switch niri))
  to_clk  (multi @kill_warpd (layer-switch ctrl_locked))
  to_slk  (multi @kill_warpd (layer-switch super_locked))
  to_alk  (multi @kill_warpd (layer-switch alt_locked))
  to_shlk (multi @kill_warpd (layer-switch shift_locked))
  to_chrom (multi @kill_warpd (layer-switch chromium))
  to_term (multi @kill_warpd (layer-switch terminals))
  to_vis  (multi @kill_warpd (layer-switch visual))
  to_bp   (multi @kill_warpd (layer-switch bypass))

  to_arm_slk  (multi @kill_warpd (layer-switch super_armed_slk))
  to_arm_clk  (multi @kill_warpd (layer-switch super_armed_clk))
  to_arm_alk  (multi @kill_warpd (layer-switch super_armed_alk))
  to_arm_shlk (multi @kill_warpd (layer-switch super_armed_shlk))

  to_nav_slk  (multi @kill_warpd (layer-switch nav_slk))
  to_nav_clk  (multi @kill_warpd (layer-switch nav_clk))

  ;; Esc definition:
  ;; Zero-latency immediate reset: releases all modifiers, sends Esc, and switches to normal mode.
  esc_reset (multi (release-key lmet) (release-key lctl) (release-key lalt) (release-key lsft) @kill_warpd esc @to_norm)

  ;; Transitions that switch layer without consuming waiting one-shot modifiers
  nav_preserve  (multi (one-shot-pause-processing 100) @to_nav)
  norm_preserve (multi (one-shot-pause-processing 100) @to_norm)

  ;; Issue #101: Tab & Ret in modal layers emit native keys and return to normal mode
  tab_to_norm (multi tab @to_norm)
  ret_to_norm (multi ret @to_norm)

  ;; Normal mode triggers:
  ;; CapsLock: single-tap enters navigate (@nav_preserve); double-tap enters super (@to_sup);
  ;; hold acts as chord modifier for layers (1:niri, 2:chrom, 3:term, spc:super, `:nav).
  ;; Shift + CapsLock triggers real CapsLock hardware toggle if needed.
  caps_lwh         (layer-while-held caps_mode)
  caps_td_norm     (tap-dance 200 (@nav_preserve @to_sup))
  caps_held_norm   (tap-hold-press 200 200 @caps_td_norm @caps_lwh)
  caps_to_nav      (fork @caps_held_norm caps (lsft rsft))

  ;; Unified CapsLock in all sub-layers:
  ;; Single-tap returns directly to normal mode (@norm_preserve) with zero delay.
  ;; Hold acts as chord modifier for quick layer switches (@caps_lwh).
  ;; Shift + CapsLock triggers real CapsLock hardware toggle if needed.
  caps_held_exit   (tap-hold-press 200 200 @norm_preserve @caps_lwh)
  caps_exit        (fork @caps_held_exit caps (lsft rsft))
  caps_nav_direct  @caps_exit
  caps_nav_layer   @caps_exit

  ;; Navigation from locked modes: double-tap CapsLock to navigate
  caps_td_slk   (tap-dance 200 (XX @to_nav_slk))
  caps_held_slk (tap-hold-press 200 200 @caps_td_slk @caps_lwh)
  caps_to_nav_slk (fork @caps_held_slk caps (lsft rsft))

  caps_td_clk   (tap-dance 200 (XX @to_nav_clk))
  caps_held_clk (tap-hold-press 200 200 @caps_td_clk @caps_lwh)
  caps_to_nav_clk (fork @caps_held_clk caps (lsft rsft))

  i_to_slk (fork @to_slk A-rght (lctl rctl))
  i_to_clk (fork @to_clk A-rght (lctl rctl))

  ;; --------------------------------------------------------------------------
  ;; Chromium Layer Actions (Browser Navigation via CapsLock + 2)
  ;; --------------------------------------------------------------------------
  ch_t (fork C-t C-S-t (lsft rsft))
  ch_h (multi lctl lsft tab)
  ch_l (multi lctl tab)
  ch_j down
  ch_k up
  ch_x C-w
  ch_r (fork C-r C-S-r (lsft rsft))

  ch_1 C-1
  ch_2 C-2
  ch_3 C-3
  ch_4 C-4
  ch_5 C-5
  ch_6 C-6
  ch_7 C-7
  ch_8 C-8
  ch_9 C-9
  ch_0 C-9

  ;; --------------------------------------------------------------------------
  ;; Navigate Layer Actions
  ;; --------------------------------------------------------------------------
  tab_nav A-tab

  ;; h/j/k/l: Arrows alone; with Ctrl -> Tab/Page motions
  h_nav (fork left (multi lctl lsft tab) (lctl rctl))
  l_nav (fork rght (multi lctl tab) (lctl rctl))
  j_nav (fork down C-pgdn (lctl rctl))
  k_nav (fork up   C-pgup (lctl rctl))

  ;; d/u: PageDown / PageUp (with Ctrl -> C-pgdn / C-pgup)
  d_nav (fork pgdn C-pgdn (lctl rctl))
  u_nav (fork pgup C-pgup (lctl rctl))

  ;; o/i: Jump Backward (Alt+Left) / Forward (Alt+Right).
  ;; i alone returns to normal mode preserving waiting modifiers.
  o_nav (fork o A-left (lctl rctl))
  i_nav (fork @norm_preserve A-rght (lctl rctl))

  ;; Word & Line motions
  w_fwd C-rght
  w_bwd C-left
  key_4 (fork 4 end (lsft rsft))
  g_td  (tap-dance 250 (XX C-home))
  g_nav (fork @g_td C-end (lsft rsft))

  ;; --------------------------------------------------------------------------
  ;; Visual Layer Actions (Text Selection & Clipboard via 'v' in Navigate)
  ;; --------------------------------------------------------------------------
  vis_y    (multi C-c @to_nav)
  vis_x    (multi C-x @to_nav)
  vis_c    (multi C-x @to_norm)
  vis_p    (multi C-v @to_nav)
  vis_w    C-S-rght
  vis_b    C-S-left
  vis_h    S-left
  vis_l    S-rght
  vis_j    S-down
  vis_k    S-up
  vis_0    S-home
  vis_4    S-end
  vis_g_td (tap-dance 250 (XX C-S-home))
  vis_g    (fork @vis_g_td C-S-end (lsft rsft))

  ;; --------------------------------------------------------------------------
  ;; Terminals Layer Actions (Zellij Multiplexer Navigation via CapsLock + 3)
  ;; --------------------------------------------------------------------------
  tm_h (fork C-h C-S-left (lsft rsft))
  tm_l (fork C-l C-S-rght (lsft rsft))
  tm_j (fork down C-j (lctl rctl))
  tm_k (fork up   C-k (lctl rctl))
  tm_s C-S-s
  tm_x (fork C-S-w C-S-q (lsft rsft))
  tm_w (fork C-S-p C-S-e (lsft rsft))
  tm_t C-S-t
  tm_n C-S-n
  tm_d C-S-d
  tm_f C-S-f
  tm_r C-S-r
  tm_b C-S-b
  tm_srch C-S-/
  tm_z C-S-z
  tm_a C-S-a
  tm_prev C-S-[
  tm_next C-S-]

  tm_1 C-S-1
  tm_2 C-S-2
  tm_3 C-S-3
  tm_4 C-S-4
  tm_5 C-S-5
  tm_6 C-S-6
  tm_7 C-S-7
  tm_8 C-S-8
  tm_9 C-S-9
  tm_0 C-S-9

  ;; --------------------------------------------------------------------------
  ;; Super Layer Actions (One-Shot Modifiers & Sticky Locks with Shift)
  ;; --------------------------------------------------------------------------
  os_super (one-shot 2000 lmet)
  os_shift (one-shot 2000 lsft)
  os_ctrl  (one-shot 2000 lctl)
  os_alt   (one-shot 2000 lalt)

  sup_a_raw (chord sup_mod a)
  sup_s_raw (chord sup_mod s)
  sup_d_raw (chord sup_mod d)
  sup_f_raw (chord sup_mod f)

  ;; Pressing key alone -> One-shot or chord for next key only
  ;; Pressing Shift + key -> Arms sticky lock, Esc transitions into locked mode
  sup_a (fork @sup_a_raw @to_arm_slk  (lsft rsft))
  sup_s (fork @sup_s_raw @to_arm_shlk (lsft rsft))
  sup_d (fork @sup_d_raw @to_arm_clk  (lsft rsft))
  sup_f (fork @sup_f_raw @to_arm_alk  (lsft rsft))

  ;; --------------------------------------------------------------------------
  ;; Niri Layer Actions
  ;; --------------------------------------------------------------------------
  ;; h/l: Focus column (with Ctrl -> move column, with Shift -> focus monitor, with Alt -> move to monitor)
  h_niri (fork M-h (fork C-M-h (fork S-M-h (multi lmet lctl lsft h) (lalt ralt)) (lsft rsft)) (lctl rctl))
  l_niri (fork M-l (fork C-M-l (fork S-M-l (multi lmet lctl lsft l) (lalt ralt)) (lsft rsft)) (lctl rctl))

  ;; j/k: Focus workspace (with Ctrl -> move column to workspace)
  j_niri (fork M-j C-M-j (lctl rctl))
  k_niri (fork M-k C-M-k (lctl rctl))

  ;; 1-9: Move to workspace 1-9 (with Ctrl -> move window to workspace 1-9)
  n1 (fork M-1 C-M-1 (lctl rctl))
  n2 (fork M-2 C-M-2 (lctl rctl))
  n3 (fork M-3 C-M-3 (lctl rctl))
  n4 (fork M-4 C-M-4 (lctl rctl))
  n5 (fork M-5 C-M-5 (lctl rctl))
  n6 (fork M-6 C-M-6 (lctl rctl))
  n7 (fork M-7 C-M-7 (lctl rctl))
  n8 (fork M-8 C-M-8 (lctl rctl))
  n9 (fork M-9 C-M-9 (lctl rctl))

  ;; One-shot actions that automatically return to normal mode
  niri_center (multi (macro M-c 50) @to_norm)
  niri_proj   (multi (macro M-p 50) @to_norm)
  niri_shot   (multi (macro M-s 50) @to_norm)
  niri_rec    (multi (macro M-r 50) @to_norm)
  niri_menu   (multi (macro M-d 50) @to_norm)
  niri_term   (multi (macro M-ret 50) @to_norm)
  niri_over   (multi (macro M-o 50) @to_norm)
  niri_clip   (multi (macro M-v 50) @to_norm)

  ;; --------------------------------------------------------------------------
  ;; Warpd Pointer Layer Actions (Mouse Emulation via Issue #28)
  ;; --------------------------------------------------------------------------
  warp_hint (multi (release-key lsft) (release-key rsft) (macro M-A-p 50))
  warp_norm (multi (release-key lsft) (release-key rsft) (macro M-A-m 50))
  warp_hint_norm (multi (release-key lsft) (release-key rsft) (macro M-A-p 50) @to_norm)
  warp_norm_norm (multi (release-key lsft) (release-key rsft) (macro M-A-m 50) @to_norm)
  m_nav     (fork @warp_hint_norm @warp_norm_norm (lsft rsft))
  m_caps    (fork @warp_hint @warp_norm (lsft rsft))

  ;; Quick Keybind Cheat-Sheet Toggle (Shift + / across modal layers)
  cheat_help (multi (release-key lsft) (release-key rsft) M-S-/)
  nav_slash  (fork C-f @cheat_help (lsft rsft))
  vis_slash  (fork C-f @cheat_help (lsft rsft))
  sup_slash  (fork /   @cheat_help (lsft rsft))
  ch_slash   (fork /   @cheat_help (lsft rsft))
  tm_slash   (fork @tm_srch @cheat_help (lsft rsft))
  niri_slash (fork /   @cheat_help (lsft rsft))
)

;; ----------------------------------------------------------------------------
;; Super Layer Modifier Chords (Simultaneous Presses on a s d f)
;; ----------------------------------------------------------------------------
(defchords sup_mod 150
  ;; Single Modifiers
  (a)       @os_super
  (s)       @os_shift
  (d)       @os_ctrl
  (f)       @os_alt

  ;; 2-Key Chords (Dual Modifiers)
  (a d)     (multi @os_super @os_ctrl)               ;; Super + Ctrl
  (a s)     (multi @os_super @os_shift)              ;; Super + Shift
  (a f)     (multi @os_super @os_alt)                ;; Super + Alt
  (d s)     (multi @os_ctrl @os_shift)               ;; Ctrl + Shift
  (d f)     (multi @os_ctrl @os_alt)                 ;; Ctrl + Alt
  (s f)     (multi @os_shift @os_alt)                ;; Shift + Alt

  ;; 3-Key Chords (Triple Modifiers)
  (a d f)   (multi @os_super @os_ctrl @os_alt)       ;; Super + Ctrl + Alt
  (a s f)   (multi @os_super @os_shift @os_alt)      ;; Super + Shift + Alt
  (a s d)   (multi @os_super @os_shift @os_ctrl)     ;; Super + Shift + Ctrl
  (d s f)   (multi @os_ctrl @os_shift @os_alt)       ;; Ctrl + Shift + Alt (Meh)

  ;; 4-Key Chord (Quad Modifier)
  (a s d f) (multi @os_super @os_shift @os_ctrl @os_alt) ;; Hyper
)

;; ----------------------------------------------------------------------------
;; Direct Sequential Key Sequences (Tap CapsLock + <key>)
;; ----------------------------------------------------------------------------
(defvirtualkeys
  v_sup    (multi (release-key lsft) (release-key rsft) (macro M-A-esc 50) (layer-switch super))
  v_nav    (multi (release-key lsft) (release-key rsft) (macro M-A-esc 50) (one-shot-pause-processing 100) (layer-switch navigate))
  v_niri   (multi (release-key lsft) (release-key rsft) (macro M-A-esc 50) (layer-switch niri))
  v_chrom  (multi (release-key lsft) (release-key rsft) (macro M-A-esc 50) (layer-switch chromium))
  v_term   (multi (release-key lsft) (release-key rsft) (macro M-A-esc 50) (layer-switch terminals))
  v_warp   (multi (macro M-A-p 50))
  v_warp_m (multi (macro M-A-m 50))
)

(defseq
  v_sup    (caps spc)
  v_nav    (caps grv)
  v_niri   (caps 1)
  v_chrom  (caps 2)
  v_term   (caps 3)
  v_warp   (caps 4)
  v_warp_m (caps m)
)

;; ----------------------------------------------------------------------------
;; CapsLock Chord Layer (Active strictly while holding CapsLock)
;; ----------------------------------------------------------------------------
(deflayer caps_mode
  _    _    _    _    _    _    _    _    _    _    _    _    _
  @to_nav @to_niri @to_chrom @to_term @warp_hint _ _ _ _ _    _    _    _    _
  _    _    _    _    _    _    _    @u_nav _    _    _    _    _    _
  _    _    _    @d_nav _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    @m_caps _ _    _    _
  _    _    _              @to_sup        _    _    _
)

;; ----------------------------------------------------------------------------
;; 1. Normal Layer (Default Physical Typing)
;; ----------------------------------------------------------------------------
(deflayer normal
  @esc_reset f1 f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @caps_to_nav a s d  f    g    h    j    k    l    ;    apos ret
  lsft z    x    c    v    b    n    m    ,    .    /    @to_sup
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 2. Navigate Layer (Vim Motions & Tab/Word Controls)
;; ----------------------------------------------------------------------------
(deflayer navigate
  @esc_reset f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  @to_nav @to_niri @to_chrom @to_term @key_4 5 6 7 8 9 home - = bspc
  @tab_to_norm q    @w_fwd @w_fwd C-y  t    C-c  @u_nav @i_nav @o_nav C-v [   ]   \
  @caps_nav_direct C-a s    @d_nav f  @g_nav @h_nav @j_nav @k_nav @l_nav ; apos @ret_to_norm
  lsft C-z  del  c    @to_vis @w_bwd n  @m_nav ,    .    @nav_slash  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 3. Visual Layer (Text Selection & Clipboard Actions via 'v' in Navigate)
;; ----------------------------------------------------------------------------
(deflayer visual
  @esc_reset f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  @to_nav 1    2    3    @vis_4 5 6   7    8    9    @vis_0 -  =    bspc
  @tab_to_norm q    @vis_w @vis_w C-y  t    @vis_y @u_nav @norm_preserve @d_nav @vis_p [ ] \
  @caps_nav_layer C-a s    @d_nav f  @vis_g @vis_h @vis_j @vis_k @vis_l ; apos @ret_to_norm
  lsft C-z  @vis_x @vis_c @to_nav @vis_b n  @m_nav ,    .    @vis_slash  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 3. Super Layer (One-Shot Modifiers & Sticky Locks)
;; ----------------------------------------------------------------------------
(deflayer super
  @esc_reset f1 f2 f3 f4  f5   f6   f7   f8   f9   f10  f11  f12
  grv  @to_niri @to_chrom @to_term 4 5 6 7 8 9 0 - = bspc
  @tab_to_norm q    w    e    r    t    y    @u_nav @norm_preserve o p [ ]   \
  @caps_nav_layer @sup_a @sup_s @sup_d @sup_f g h j k l ; apos @ret_to_norm
  lsft z    x    @to_arm_clk v b    n    @m_nav ,    .    @sup_slash    @norm_preserve
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 4. Chromium Layer (Browser Tab & Page Navigation via CapsLock + 2)
;; ----------------------------------------------------------------------------
(deflayer chromium
  @esc_reset f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  @ch_1 @ch_2 @ch_3 @ch_4 @ch_5 @ch_6 @ch_7 @ch_8 @ch_9 @ch_0 - = bspc
  @tab_to_norm q    w    e    @ch_r @ch_t y    @u_nav @norm_preserve o p [ ] \
  @caps_nav_layer a s @d_nav f g @ch_h @ch_j @ch_k @ch_l ; apos @ret_to_norm
  lsft z    @ch_x c    v    b    n    @m_nav ,    .    @ch_slash    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 5. Terminals Layer (Zellij Multiplexer Navigation via CapsLock + 3)
;; ----------------------------------------------------------------------------
(deflayer terminals
  @esc_reset f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  @tm_1 @tm_2 @tm_3 @tm_4 @tm_5 @tm_6 @tm_7 @tm_8 @tm_9 @tm_0 - = bspc
  @tab_to_norm @tm_x @tm_w e    @tm_r @tm_t y    @u_nav @norm_preserve o p @tm_prev @tm_next \
  @caps_nav_layer @tm_a @tm_s @d_nav @tm_f g @tm_h @tm_j @tm_k @tm_l ; apos @ret_to_norm
  lsft @tm_z @tm_x c    v    @tm_b @tm_n @m_nav ,    .    @tm_slash rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 6. Niri Layer (Window & Workspace Management)
;; ----------------------------------------------------------------------------
(deflayer niri
  @esc_reset f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  @n1  @n2  @n3  @n4  @n5  @n6  @n7  @n8  @n9  M-0  M--  M-=  bspc
  @tab_to_norm M-q w e  @niri_rec @niri_term y @u_nav @norm_preserve @niri_over @niri_proj [ ] \
  @caps_nav_layer a    @niri_shot @niri_menu M-f g @h_niri @j_niri @k_niri @l_niri ; apos @ret_to_norm
  lsft z    x    @niri_center @niri_clip b n @m_nav , . @niri_slash rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 5. Ctrl Locked Layer (Sticky Ctrl until Esc in Normal Mode)
;; ----------------------------------------------------------------------------
(deflayer ctrl_locked
  @esc_reset f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  C-1  C-2  C-3  C-4  C-5  C-6  C-7  C-8  C-9  C-0  C--  C-=  bspc
  tab  C-q  C-w  C-e  C-r  C-t  C-y  C-u  C-i  C-o  C-p  C-[  C-]  C-\
  @caps_to_nav_clk C-a C-s C-d C-f C-g C-h C-j C-k C-l C-; apos ret
  lsft C-z  C-x  C-c  C-v  C-b  C-n  C-m  C-,  C-.  C-/  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 6. Super Locked Layer (Sticky Super until Esc in Normal Mode)
;; ----------------------------------------------------------------------------
(deflayer super_locked
  @esc_reset f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  M-1  M-2  M-3  M-4  M-5  M-6  M-7  M-8  M-9  M-0  M--  M-=  bspc
  tab  M-q  M-w  M-e  M-r  M-t  M-y  M-u  M-i  M-o  M-p  M-[  M-]  M-\
  @caps_to_nav_slk M-a M-s M-d M-f M-g M-h M-j M-k M-l M-; apos ret
  lsft M-z  M-x  M-c  M-v  M-b  M-n  M-m  M-,  M-.  M-/  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 7. Alt Locked Layer (Sticky Alt until Esc in Normal Mode)
;; ----------------------------------------------------------------------------
(deflayer alt_locked
  @esc_reset f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  A-1  A-2  A-3  A-4  A-5  A-6  A-7  A-8  A-9  A-0  A--  A-=  bspc
  tab  A-q  A-w  A-e  A-r  A-t  A-y  A-u  A-i  A-o  A-p  A-[  A-]  A-\
  @to_norm A-a A-s  A-d  A-f  A-g  A-h  A-j  A-k  A-l  A-;  apos ret
  lsft A-z  A-x  A-c  A-v  A-b  A-n  A-m  A-,  A-.  A-/  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; 8. Shift Locked Layer (Sticky Shift until Esc in Normal Mode)
;; ----------------------------------------------------------------------------
(deflayer shift_locked
  @esc_reset f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  S--  S-=  bspc
  tab  S-q  S-w  S-e  S-r  S-t  S-y  S-u  S-i  S-o  S-p  S-[  S-]  S-\
  @to_norm S-a S-s  S-d  S-f  S-g  S-h  S-j  S-k  S-l  S-;  apos ret
  lsft S-z  S-x  S-c  S-v  S-b  S-n  S-m  S-,  S-.  S-/  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; Intermediate Armed States (Pressing Esc transitions into locked mode)
;; ----------------------------------------------------------------------------
(deflayer super_armed_slk
  @to_slk f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv     @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk - = bspc
  tab     @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk [ ] \
  @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk ; apos ret
  lsft    @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk @to_slk , . / rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer super_armed_clk
  @to_clk f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv     @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk - = bspc
  tab     @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk [ ] \
  @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk ; apos ret
  lsft    @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk @to_clk , . / rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer super_armed_alk
  @to_alk f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv     @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk - = bspc
  tab     @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk [ ] \
  @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk ; apos ret
  lsft    @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk @to_alk , . / rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer super_armed_shlk
  @to_shlk f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv      @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk - = bspc
  tab      @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk [ ] \
  @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk ; apos ret
  lsft     @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk @to_shlk , . / rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; Navigation from Locked Modes (Returns to respective locked mode on exit)
;; ----------------------------------------------------------------------------
(deflayer nav_slk
  @esc_reset f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  @to_slk @to_niri @to_chrom @to_term @key_4 5 6 7    8    9    home -    =    bspc
  @tab_to_norm q    @w_fwd @w_bwd C-y  t    C-c  @u_nav @i_to_slk @o_nav C-v [ ] \
  @to_slk C-a s    @d_nav f  @g_nav @h_nav @j_nav @k_nav @l_nav ; apos @ret_to_norm
  lsft C-z  del  c    @to_vis @w_bwd n  @m_nav ,    .    @nav_slash  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer nav_clk
  @esc_reset f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  @to_clk @to_niri @to_chrom @to_term @key_4 5 6 7    8    9    home -    =    bspc
  @tab_to_norm q    @w_fwd @w_bwd C-y  t    C-c  @u_nav @i_to_clk @o_nav C-v [ ] \
  @to_clk C-a s    @d_nav f  @g_nav @h_nav @j_nav @k_nav @l_nav ; apos @ret_to_norm
  lsft C-z  del  c    @to_vis @w_bwd n  @m_nav ,    .    @nav_slash  rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ----------------------------------------------------------------------------
;; Bypass Layer (Raw 1:1 Hardware Passthrough)
;; ----------------------------------------------------------------------------
(deflayer bypass
  @esc_reset f1 f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    apos ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)
