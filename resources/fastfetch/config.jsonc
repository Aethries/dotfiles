{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#4dd9e6",
      "2": "#63d3dd"
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "keys": "#4dd9e6",
      "title": "#81d3dd"
    },
    "percent": {
      "color": {
        "green": "#a2c9fe",
        "yellow": "#4dd9e6",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "Host"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Pkgs"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    "break",
    "colors"
  ]
}
