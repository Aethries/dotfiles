# ==============================================================================
# Warpd Configuration: Modal Keyboard-Driven Pointer & GUI Navigation
# Reference: Issue #28 & docs/keymap-architecture.md
# ==============================================================================

# Core Movement & Acceleration
speed: 700
max_speed: 4500
acceleration: 1800
accelerator_acceleration: 9000
decelerator_speed: 40
decelerator: s
accelerator: a
repeat_interval: 10

# Vim-style cursor navigation
left: h
down: j
up: k
right: l

# Screen edge jumps
top: H
middle: M
bottom: L
start: 0
end: $

# Scrolling (d: down, u: up)
scroll_down: d
scroll_up: u
scroll_speed: 350
scroll_max_speed: 5000
scroll_acceleration: 1600

# Mouse clicks & Dragging
# Persistent clicks (stay in warpd for multiple clicks/drags)
buttons: space , .
# Oneshot clicks (click and immediately exit warpd back to typing)
oneshot_buttons: i - /
drag: v
drag_button: 1
copy_and_exit: c

# In-session Jump Transitions (Inside Normal/Movement mode)
hint: f
grid: g

# Hint Mode (Vimium-like screen target selection)
hint_chars: asdfghjklqwertyuiopzxcvbnm
hint_font: monospace
hint_size: 13
hint_border_radius: 3
hint_bgcolor: #1e1e2ecc
hint_fgcolor: #cdd6f4
hint_exit: esc
hint_undo: backspace
hint_undo_all: C-u

# Grid Mode (3x6 Two-Hand Matrix Navigation, 18 cells)
grid_keys: q w e u i o a s d j k l z x c m , .
grid_nr: 3
grid_nc: 6
grid_size: 3
grid_color: #1e1e2e
grid_border_color: #89b4fa
grid_exit: esc

# Visual Indicator in normal mode
indicator: topleft
indicator_color: #a6e3a1
indicator_size: 10
cursor_color: #f38ba8
cursor_size: 14
exit: esc
