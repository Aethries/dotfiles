# Machine-specific generated hardware and configuration
.machine/

# Editor temporary, backup, and swap files
*.swp
*.swo
*~
*.bak
*.tmp
*.orig

# OS and runtime generated artifacts
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# Sensitive credentials & environment files (prevent accidental plaintext commit)
.env
.env.*
!.envrc
*.pem
*.key
id_rsa
id_ed25519
id_ecdsa
*.vault
*.vault.*
# Portable encrypted archive is ignored by default; intentional sharing requires `git add -f`.
secrets.enc
secrets.age

# Plaintext secrets directory (only .gitkeep is tracked)
secrets/*
!secrets/.gitkeep

# Build or test temporary scratch folders
scratch/
.sandbox/
result
result-*
